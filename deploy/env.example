# ===== Irodori-TTS-Server 本地部署配置 =====
# 机器: ylws (CMP 40HX 8GB, sm_75)  |  模型: Irodori-TTS-v4.1-Small

# ---- 监听 ----
IRODORI_HOST=0.0.0.0
IRODORI_PORT=8088

# ---- 模型（本地文件，不走 HF）----
IRODORI_CHECKPOINT=/vol2/1000/Irodori-TTS/models/Irodori-TTS-v4.1-Small/model.safetensors
IRODORI_CODEC_REPO=/vol2/1000/Irodori-TTS/models/dacvae/weights.pth
IRODORI_MODEL_NAME=irodori-tts

# ---- 设备 / 精度 ----
# CMP 40HX 是 Turing (sm_75)：无原生 bf16（软件仿真，慢）。用 fp16——有真实张量核心
IRODORI_MODEL_DEVICE=cuda
IRODORI_CODEC_DEVICE=cuda
IRODORI_MODEL_PRECISION=fp16
IRODORI_CODEC_PRECISION=fp32
IRODORI_COMPILE_MODEL=false
IRODORI_COMPILE_DYNAMIC=false

# ---- 加载 / 并发 ----
IRODORI_PRELOAD=true
IRODORI_MODEL_LOAD_TIMEOUT=300
# 2 路并发：运行时池预加载 2 个 runtime（基座权重共享，+约 105 MiB）
IRODORI_RUNTIME_POOL_SIZE=2
IRODORI_MAX_CONCURRENT_SYNTHESIS=2
IRODORI_SYNTHESIS_WAIT_TIMEOUT=300
# 每 2 次合成释放一次 allocator 缓存，压低并发峰值
IRODORI_EMPTY_CACHE_INTERVAL=2
# 服务端步数上限（0 = 不限制）。插件固定发 40 步，这里压到 24 提升吞吐
IRODORI_MAX_NUM_STEPS=24

# ---- voices ----
IRODORI_VOICES_DIR=voices
IRODORI_ALLOW_NO_REF_VOICE=true

# ---- 默认推理参数 ----
IRODORI_DEFAULT_RESPONSE_FORMAT=wav
IRODORI_DEFAULT_NUM_STEPS=40
IRODORI_DEFAULT_T_SCHEDULE_MODE=linear
IRODORI_DEFAULT_DURATION_SCALE=1.0
IRODORI_DEFAULT_CFG_SCALE_TEXT=3.0
IRODORI_DEFAULT_CFG_SCALE_SPEAKER=5.0
IRODORI_DEFAULT_CFG_GUIDANCE_MODE=independent
IRODORI_DEFAULT_CHUNKING_ENABLED=true
IRODORI_DEFAULT_CHUNK_MIN_CHARS=80
